# EZA PRO - Environment Configuration
# Copy this file to .env for optional local overrides in development mode

# Add your Gemini API key securely inside the app's Router / API Key Manager.

# Default Drama Folder (Optional)
DOWNLOAD_DIR=

# Server Port (Default: 3001)
PORT=3001

# FFmpeg Binary Path (Leave empty to use bundled/system ffmpeg)
FFMPEG_BIN=

# Audio Cache Directory (Default: ./audio_cache)
AUDIO_CACHE_DIR=

# Export Directory (Default: ./Exported)
EXPORT_DIR=
