# SHARK STUDIO PRO - Environment Configuration
# Copy this file to .env and fill in your actual values

# Add your Gemini API key in the app's Gemini API Settings.

# Download Directory for Drama Files
DOWNLOAD_DIR=D:\HDRG

# Server Port (Default: 3001)
PORT=3001

# FFmpeg Binary Path (Leave empty to use system ffmpeg)
FFMPEG_BIN=

# Audio Cache Directory (Default: ./audio_cache)
AUDIO_CACHE_DIR=

# Export Directory (Default: D:\HDRG\Exported)
EXPORT_DIR=
